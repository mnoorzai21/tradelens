generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Side {
  LONG
  SHORT
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trades  Trade[]
  setups  Setup[]
  tags    Tag[]
  imports Import[]
}

model Setup {
  id     String  @id @default(cuid())
  name   String
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@unique([userId, name])
}

model Tag {
  id     String  @id @default(cuid())
  name   String
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@unique([userId, name])
}

model Trade {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol     String
  side       Side
  entryPrice Decimal  @db.Decimal(12, 4)
  exitPrice  Decimal  @db.Decimal(12, 4)
  stopPrice  Decimal? @db.Decimal(12, 4)
  shares     Int
  fees       Decimal  @default(0) @db.Decimal(10, 2)
  entryAt    DateTime
  exitAt     DateTime
  notes      String?
  setupId    String?
  setup      Setup?   @relation(fields: [setupId], references: [id], onDelete: SetNull)
  tags       Tag[]
  importId   String?
  import     Import?  @relation(fields: [importId], references: [id], onDelete: SetNull)
  dedupeHash String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, dedupeHash])
  @@index([userId, exitAt])
  @@index([userId, symbol])
}

model Import {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker    String
  filename  String
  rowCount  Int
  createdAt DateTime @default(now())
  trades    Trade[]
}
